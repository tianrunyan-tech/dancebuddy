# Copy to .env (git-ignored) and fill in. Only the agent and the planner baseline need a key.
OPENROUTER_API_KEY=sk-or-v1-...        # https://openrouter.ai/keys

# only for making new characters with the agent (--new-character)
# TRIPO_API_KEY=tsk_...                 # https://platform.tripo3d.ai

# optional
# DANCEBUDDY_MODEL=openai/gpt-6-sol    # any OpenRouter model with tool calling and image input
# DANCEBUDDY_REASONING_EFFORT=low
# BLENDER=/Applications/Blender.app/Contents/MacOS/Blender   # only if you use the Blender app instead of bpy
